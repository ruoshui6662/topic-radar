# ============ 复制为 .env 并填写 ============

# DeepSeek（必填，platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 飞书机器人（必填，飞书群 → 设置 → 群机器人 → 自定义机器人 → 复制 webhook）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# 数据库（本地开发用 SQLite；NAS 部署改为 Postgres）
DATABASE_URL=sqlite:///./data/workbench.db
# DATABASE_URL=postgresql+psycopg://workbench:workbench@postgres:5432/workbench

# 调度
COLLECT_INTERVAL_MIN=30     # 热榜采集间隔（分钟）
REPORT_HOUR=7               # 日报生成时间
REPORT_MINUTE=30
PUSH_HOUR=8                 # 日报推送时间
PUSH_MINUTE=0
TOP_N_TOPICS=15             # 日报中最多评估的话题数
TZ=Asia/Shanghai
